+  /** Close the camera now (app paused / headset taken off). No-op when nothing is running. */
+  fun cancel(reason: String) {
+    if (!finished && (camera != null || reader != null)) finish(Result(false, reason))
+  }
+
   private fun finish(r: Result) {
     if (finished) return
     finished = true
