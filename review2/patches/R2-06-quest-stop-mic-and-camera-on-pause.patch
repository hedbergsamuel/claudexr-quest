diff --git a/quest-app/app/src/main/java/com/claudexr/quest/MainActivity.kt b/quest-app/app/src/main/java/com/claudexr/quest/MainActivity.kt
index 53ffb11..942e459 100644
--- a/quest-app/app/src/main/java/com/claudexr/quest/MainActivity.kt
+++ b/quest-app/app/src/main/java/com/claudexr/quest/MainActivity.kt
@@ -162,6 +162,15 @@ class MainActivity : AppSystemActivity() {
   }
 
   override fun onPause() {
+    // Review 2 R2-06: the microphone and the passthrough camera must not stay open while the app is in
+    // the background (headset taken off mid push-to-talk: the "release" event never arrives).
+    voiceId?.let { id ->
+      voiceId = null
+      recorder.stop()
+      showMic(false)
+      connection.sendMedia(Protocol.voiceCancel(id))
+    }
+    if (::calibrator.isInitialized) calibrator.cancel("app_paused")
     runCatching { if (wifiLock?.isHeld == true) wifiLock?.release() }
     super.onPause()
   }
