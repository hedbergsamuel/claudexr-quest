+
+test("welcome lists the panels that are still open (headset keeps them instead of reloading)", async () => {
+  const port = nextPort();
+  const b = await startBridge(port);
+  const first = await startSim(port);
+  try {
+    const r = await b.call("xr_preview", { url: "https://example.com/" });
+    first.close();
+    await new Promise((res) => setTimeout(res, 200));
+    const { WebSocket } = await import("ws");
+    const ws = new WebSocket(`ws://127.0.0.1:${port}/headset`);
+    const welcome = await new Promise<any>((resolve) => {
+      ws.on("open", () => ws.send(JSON.stringify({ type: "hello", protocol: 1 })));
+      ws.on("message", (raw) => {
+        const m = JSON.parse(raw.toString());
+        if (m.type === "welcome") resolve(m);
+      });
+    });
+    assert.deepEqual(welcome.open, [r.json.panelId]);
+    ws.close();
+  } finally {
+    await b.close();
+  }
+});
