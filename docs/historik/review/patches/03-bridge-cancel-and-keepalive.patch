+/** What the MCP SDK passes as the second handler argument (subset we use). */
+interface Extra {
+  signal: AbortSignal;
+  _meta?: { progressToken?: string | number };
+  sendNotification: (n: { method: "notifications/progress"; params: { progressToken: string | number; progress: number; message?: string } }) => Promise<void>;
+}
+
+/**
+ * Run a blocking headset command with cancellation and keep-alive progress.
+ * Progress notifications count as activity for Claude Code's MCP idle timeout (30 min for stdio).
+ */
+async function blocking(backend: XrBackend, cmd: HubCommand, extra: Extra): Promise<CommandResult> {
+  const token = extra._meta?.progressToken;
+  let n = 0;
+  const keepAlive =
+    token === undefined
+      ? undefined
+      : setInterval(() => {
+          extra
+            .sendNotification({ method: "notifications/progress", params: { progressToken: token, progress: ++n, message: "waiting for the user in XR" } })
+            .catch(() => {});
+        }, 15_000);
+  try {
+    return await backend.execute(cmd, extra.signal);
+  } finally {
+    clearInterval(keepAlive);
+  }
+}
