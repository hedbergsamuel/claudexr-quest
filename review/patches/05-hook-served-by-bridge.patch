new file mode 100644
index 0000000..baa30be
--- /dev/null
+++ b/bridge/src/hookctx.ts
@@ -0,0 +1,47 @@
+// Serves Claude Code hooks directly from the long-lived bridge (POST /hook/context), so a hook costs one
+// loopback HTTP request (~1-2 ms) instead of starting Node (~30-60 ms) on every prompt.
+// It also only injects context when the XR state changed for that session, instead of ~150 tokens per prompt.
+import { XrStatus } from "./protocol.js";
+
+const FULL_GUIDE =
+  "The user is wearing the Meta Quest headset and sees panels in their room. " +
+  "In this state the user prefers: xr_ask for choices between 2-4 options (instead of asking in the terminal), " +
+  "xr_preview for showing a running web page, xr_compare for comparing two variants, " +
+  "xr_test for asking them to try something, xr_show for diffs/logs, and xr_clear to tidy up. " +
+  "If an xr_* tool reports not connected or timeout, the terminal is the fallback.";
+
+/** Peer-supplied strings (device name) go into Claude's context: keep them short and inert. */
+function inert(v: string | undefined, fallback: string): string {
+  const s = (v ?? "").replace(/[^\x20-\x7E -ɏ]/g, "").replace(/[()"`]/g, "").trim().slice(0, 40);
+  return s || fallback;
+}
+
+export function stateKey(s: XrStatus): string {
+  return s.connected ? `on:${s.device ?? ""}` : "off";
+}
+
+export function contextFor(s: XrStatus, full: boolean): string {
+  if (!s.connected) return "XR: not connected (bridge running, no Quest headset connected). Questions and previews go through the terminal as usual.";
+  const head = `XR: connected (${inert(s.device, "Quest headset")}, ${s.openPanels.length} panel(s) open).`;
+  return full ? `${head} ${FULL_GUIDE}` : head;
+}
+
+export class HookContext {
+  private last = new Map<string, string>();
+
+  /** Returns the hook JSON to send back, or null for "nothing new" (empty 200 body). */
+  handle(input: { session_id?: unknown; hook_event_name?: unknown; source?: unknown }, s: XrStatus): object | null {
+    const event = typeof input.hook_event_name === "string" ? input.hook_event_name : "UserPromptSubmit";
+    const session = typeof input.session_id === "string" ? input.session_id : "";
+    const key = stateKey(s);
+    const prev = this.last.get(session);
+    const isStart = event === "SessionStart";
+    if (!isStart && prev === key) return null;
+    this.last.delete(session);
+    this.last.set(session, key);
+    if (this.last.size > 256) this.last.delete(this.last.keys().next().value as string);
+    // Full guidance on session start/compaction and on the first "connected" of a session; one line otherwise.
+    const full = isStart || (s.connected && !(prev ?? "").startsWith("on:"));
+    return { hookSpecificOutput: { hookEventName: event, additionalContext: contextFor(s, full) } };
+  }
+}
