-launchctl print "$LABEL" | grep -E "state|pid" | head -3 || true
-echo "Logs: tail -f /tmp/claudexr-bridge.log"
-echo "Next: node \"$HERE/dist/src/index.js\" print-config"
+launchctl print "$DOMAIN/$LABEL_NAME" | grep -E "state|pid" | head -3 || true
+echo "Installed from: $DEST (re-run this script after updates you trust)"
+echo "Logs: tail -f \"$LOG_DIR/bridge.log\""
+echo "Next: node \"$DEST/dist/src/index.js\" print-config"
