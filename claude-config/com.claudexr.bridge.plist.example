<?xml version="1.0" encoding="UTF-8"?>
<!-- Reference only. The real plist is GENERATED by bridge/scripts/install-daemon.sh (pinned copy in
     ~/Library/Application Support/ClaudeXR, explicit PATH, log in ~/Library/Logs/ClaudeXR, Umask 077). -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.claudexr.bridge</string>
  <key>ProgramArguments</key>
  <array>
    <string>__NODE__</string>
    <string>/Users/<användare>/Library/Application Support/ClaudeXR/bridge/dist/src/index.js</string>
    <string>daemon</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <!-- 0.3.0: NOT ProcessType Background / LowPriorityIO. Children (whisper, claudexr-capture) inherit that class and
       were throttled to the efficiency cores: speech recognition took 50 s for 6 s of audio and video frames were dropped. -->
  <key>ProcessType</key><string>Interactive</string>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>Umask</key><integer>63</integer>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>CLAUDEXR_QUIET</key><string>0</string>
  </dict>
  <key>StandardOutPath</key><string>/Users/<användare>/Library/Logs/ClaudeXR/bridge.log</string>
  <key>StandardErrorPath</key><string>/Users/<användare>/Library/Logs/ClaudeXR/bridge.log</string>
</dict>
</plist>
