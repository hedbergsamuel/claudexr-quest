 });
+
+test("non-http(s) URLs are rejected before they reach the headset", async () => {
+  const port = nextPort();
+  const b = await startBridge(port);
+  const sim = await startSim(port);
+  try {
+    for (const url of ["javascript:alert(1)", "file:///etc/passwd", "data:text/html,<script>1</script>", "intent://x#Intent;end"]) {
+      const r = (await b.client.callTool({ name: "xr_preview", arguments: { url } })) as { isError?: boolean };
+      assert.equal(r.isError, true, url);
+    }
+    assert.ok(!sim.lines.some((l) => l.startsWith("[sim] show")));
+  } finally {
+    sim.close();
+    await b.close();
+  }
+});
